# chat-widget runtime config (the "base" image variant).
#
# At container start, generate-env-json.sh reads this file from
#   /usr/share/nginx/html/env
# and turns it into env.json, which the widget loads as window.env.
#
# Deploy: mount this file (e.g. a k8s ConfigMap) to
#   /usr/share/nginx/html/env
# The file MUST exist or the container crashes (entrypoint runs with `set -e`).
#
# Format is plain key=value (no quotes needed).

# Backend API gateway the widget talks to.
VITE_APP_API_HOST=http://localhost:9001

# Persist widget state in the host page's localStorage (true/false).
VITE_APP_ON_LOCAL_STORAGE=false
